# Tom DATABASE_URL betyder lokal PGlite-database i .data/pglite (ingen installation nødvendig).
# Sæt den til en rigtig Postgres i produktion, fx Neon eller Supabase.
DATABASE_URL=

# Den salon, som /admin styrer.
SALON_SLUG=demo

# Kodeord til /admin. Skal sættes i produktion.
ADMIN_PASSWORD=demo

# Offentlig adresse, bruges i links i SMS og i MobilePay returnUrl.
APP_URL=http://localhost:3000

# Beskytter /api/cron/reminders. Kaldes med header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=skift-mig

# Udbydere. "mock" er standard, indtil vi har rigtige nøgler.
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
